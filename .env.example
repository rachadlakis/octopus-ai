# AI Company - Environment Configuration

# =============================================================================
# Model Provider Configuration (choose one: anthropic, openai, google)
# =============================================================================
MODEL_PROVIDER=anthropic

# API Keys (set the one matching your MODEL_PROVIDER)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# =============================================================================
# Optional: Override specific models (uses provider defaults if not set)
# =============================================================================
# Anthropic models:
#   anthropic/claude-opus-4-20250514
#   anthropic/claude-sonnet-4-20250514
#   anthropic/claude-3-5-haiku-20241022
#
# OpenAI models:
#   openai/gpt-4o
#   openai/gpt-4o-mini
#   openai/o1
#   openai/o1-mini
#
# Google models:
#   gemini/gemini-2.0-flash
#   gemini/gemini-1.5-pro
#
# DEFAULT_MODEL=anthropic/claude-sonnet-4-20250514
# FAST_MODEL=anthropic/claude-3-5-haiku-20241022
# POWERFUL_MODEL=anthropic/claude-opus-4-20250514

# =============================================================================
# MCP Tool Integration (optional)
# =============================================================================
# GitHub MCP - enables create_issue, create_pull_request, search_repositories, etc.
GITHUB_TOKEN=your_github_personal_access_token

# Slack MCP - enables send_message, read_channel, etc.
# SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Brave Search MCP - enables web search
# BRAVE_API_KEY=your_brave_api_key

# PostgreSQL MCP - enables database queries
# DATABASE_URL=postgresql://user:pass@localhost:5432/dbname

# =============================================================================
# Server Configuration
# =============================================================================
HOST=0.0.0.0
PORT=9000
